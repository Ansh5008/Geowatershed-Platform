# ========================================================
# GeoWatershed Spatial Platform - Environment Configuration
# ========================================================

# --- Frontend Environment Variables (frontend/.env.local) ---
# Next.js API rewrite proxy destination
API_ORIGIN=http://localhost:5000
NEXT_PUBLIC_API_URL=/api

# Google OAuth 2.0 Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# --- Backend API Environment Variables (backend/.env) ---
PORT=5000
DATABASE_URL=postgres://watershed:watershed@localhost:5432/watershed
PROCESSING_URL=http://localhost:8000

# Google OAuth Server Verification (optional)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
